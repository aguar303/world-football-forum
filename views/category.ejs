<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= category %> - World Football Forum
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


<!-- =====================================================
     HEADER
     ===================================================== -->

<header>

    <div class="logo">
        ⚽ <span>WORLD</span> FOOTBALL FORUM
    </div>


    <nav class="main-nav">

        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/category/berita">
                Berita
            </a>

            <a href="/category/transfer">
                Transfer
            </a>

            <a href="/category/kompetisi">
                Kompetisi
            </a>

            <a href="/category/komunitas">
                Komunitas
            </a>

        </div>


        <div class="user-nav">

            <% if (user) { %>

                <span class="user-menu">
                    👤 <%= user %>
                </span>

                <a
                    href="/logout"
                    class="logout-link"
                >
                    Logout
                </a>

            <% } else { %>

                <a href="/login">
                    Login
                </a>

            <% } %>

        </div>

    </nav>

</header>


<!-- =====================================================
     CATEGORY HERO
     ===================================================== -->

<section class="hero">

    <h1 class="category-title">

        ⚽ <%= category %>

    </h1>


    <p>

        Diskusi seputar berita, pertandingan,
        pemain, dan klub di kategori ini.

    </p>

</section>


<!-- =====================================================
     BUAT TOPIK
     ===================================================== -->

<% if (user) { %>

    <p style="margin-top: 20px;">

        <a
            href="/create"
            class="create-button"
        >

            ➕ Buat Topik Baru

        </a>

    </p>

<% } %>


<!-- =====================================================
     TOPIK TERBARU
     ===================================================== -->

<h2 class="section-title">

    🔥 Topik Terbaru

</h2>


<% if (!threads || threads.length === 0) { %>


    <div class="hero">

        <h3>

            Belum ada topik

        </h3>


        <p>

            Belum ada diskusi di kategori ini.

        </p>

    </div>


<% } else { %>


    <% threads.forEach(thread => { %>


        <div class="hero">

            <h3>

                <a
                    href="/thread/<%= thread.id %>"
                >

                    🔥 <%= thread.title %>

                </a>

            </h3>


            <p>

                <%= thread.content %>

            </p>


            <small>

                👤 <%= thread.author %>

                &nbsp; | &nbsp;

                📅 <%= thread.date || "-" %>

                &nbsp; | &nbsp;

                💬 <%= thread.comment_count || 0 %>
                komentar

                &nbsp; | &nbsp;

                👁 <%= thread.views || 0 %>
                views

            </small>

        </div>


    <% }) %>


<% } %>


<!-- =====================================================
     FOOTER
     ===================================================== -->

<footer>

    <p>
        © 2026 World Football Forum
    </p>

    <p>
        Forum komunitas sepakbola dunia
    </p>

</footer>


</body>

</html>