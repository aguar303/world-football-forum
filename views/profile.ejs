<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Profil - Forum Sahabat Bola</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>


<!-- =====================================================
     HEADER
     ===================================================== -->

<header>

    <div class="container">

        <div class="logo">
            ⚽ <span>FORUM</span> SAHABAT BOLA
        </div>

        <nav>

            <a href="/">
                Home
            </a>

            <a href="/category/berita">
                Berita
            </a>

            <a href="/category/transfer">
                Transfer
            </a>

            <a href="/category/kompetisi">
                Kompetisi
            </a>

            <a href="/category/komunitas">
                Komunitas
            </a>

            <span>
                👤 <%= user %>
            </span>

            <a href="/logout">
                Logout
            </a>

        </nav>

    </div>

</header>


<!-- =====================================================
     CONTENT
     ===================================================== -->

<main class="container">


    <!-- =================================================
         PROFIL
         ================================================= -->

    <section class="hero">

        <h1>
            👤 Profil Pengguna
        </h1>

        <p>
            Kelola akun Forum Sahabat Bola kamu.
        </p>

    </section>


    <!-- =================================================
         INFORMASI AKUN
         ================================================= -->

    <section class="hero">

        <h2>
            Informasi Akun
        </h2>

        <br>

        <p>
            <strong>Username:</strong>
            <%= user %>
        </p>

    </section>


    <!-- =================================================
         EDIT PROFIL
         ================================================= -->

    <section class="hero">

        <h2>
            ✏️ Edit Profil
        </h2>

        <br>

        <form
            action="/profile/edit"
            method="POST"
        >

            <p>

                <label for="username">
                    Username Baru
                </label>

            </p>

            <input
                type="text"
                id="username"
                name="username"
                value="<%= user %>"
                minlength="3"
                maxlength="100"
                required
                autocomplete="username"
            >

            <br>
            <br>

            <button type="submit">
                💾 Simpan Perubahan
            </button>

        </form>

    </section>


    <!-- =================================================
         STATISTIK
         ================================================= -->

    <section class="hero">

        <h2>
            📊 Statistik
        </h2>

        <br>

        <div class="profile-stats">


            <!-- JUMLAH THREAD -->

            <div class="profile-stat-card">

                <div class="profile-stat-icon">
                    📝
                </div>

                <div class="profile-stat-number">
                    <%= threadCount %>
                </div>

                <div class="profile-stat-label">
                    Jumlah Thread
                </div>

            </div>


            <!-- JUMLAH KOMENTAR -->

            <div class="profile-stat-card">

                <div class="profile-stat-icon">
                    💬
                </div>

                <div class="profile-stat-number">
                    <%= commentCount %>
                </div>

                <div class="profile-stat-label">
                    Jumlah Komentar
                </div>

            </div>


            <!-- TOTAL VIEWS -->

            <div class="profile-stat-card">

                <div class="profile-stat-icon">
                    👁️
                </div>

                <div class="profile-stat-number">
                    <%= totalViews %>
                </div>

                <div class="profile-stat-label">
                    Total Views
                </div>

            </div>


        </div>

    </section>


    <!-- =================================================
         THREAD SAYA
         ================================================= -->

    <section class="hero">

        <h2>
            📝 Thread Saya
        </h2>

        <br>


        <% if (myThreads.length === 0) { %>

            <p style="margin-top: 20px;">
                Kamu belum membuat thread.
            </p>


        <% } else { %>


            <div class="profile-thread-list">


                <% myThreads.forEach(thread => { %>


                    <div class="profile-thread-card">


                        <h3>

                            <a
                                href="/thread/<%= thread.id %>"
                            >
                                <%= thread.title %>
                            </a>

                        </h3>


                        <div class="profile-thread-meta">

                            📂 <%= thread.category %>

                            &nbsp; | &nbsp;

                            📅 <%= thread.date %>

                            &nbsp; | &nbsp;

                            💬 <%= thread.comment_count %>
                            komentar

                            &nbsp; | &nbsp;

                            👁️ <%= thread.views %>
                            views

                        </div>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </section>


    <!-- =================================================
         GANTI PASSWORD
         ================================================= -->

    <section class="hero">

        <h2>
            🔐 Ganti Password
        </h2>

        <br>


        <form
            action="/profile/change-password"
            method="POST"
        >


            <!-- PASSWORD LAMA -->

            <p>

                <label for="currentPassword">
                    Password Lama
                </label>

            </p>

            <input
                type="password"
                id="currentPassword"
                name="currentPassword"
                required
                autocomplete="current-password"
            >


            <br>
            <br>


            <!-- PASSWORD BARU -->

            <p>

                <label for="newPassword">
                    Password Baru
                </label>

            </p>

            <input
                type="password"
                id="newPassword"
                name="newPassword"
                minlength="6"
                maxlength="72"
                required
                autocomplete="new-password"
            >


            <br>
            <br>


            <!-- KONFIRMASI PASSWORD -->

            <p>

                <label for="confirmPassword">
                    Konfirmasi Password Baru
                </label>

            </p>

            <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                minlength="6"
                maxlength="72"
                required
                autocomplete="new-password"
            >


            <br>
            <br>


            <button type="submit">
                🔐 Ganti Password
            </button>


        </form>

    </section>


</main>


<!-- =====================================================
     FOOTER
     ===================================================== -->

<footer>

    <p>
        © 2026 Forum Sahabat Bola
    </p>

    <p>
        Forum komunitas sepakbola dunia
    </p>

</footer>

<script src="/js/animations.js"></script>
</body>

</html>