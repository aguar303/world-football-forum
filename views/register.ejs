<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Register - Forum Sahabat Bola</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <div class="logo">
            ⚽ <span>FORUM</span> SAHABAT BOLA
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/category/berita">Berita</a>
            <a href="/category/transfer">Transfer</a>
            <a href="/category/kompetisi">Kompetisi</a>
            <a href="/category/komunitas">Komunitas</a>
            <a href="/login">Login</a>
        </nav>
    </header>

    <main class="container">

        <div class="login-box">

            <h1>📝 Daftar</h1>

            <p>Buat akun untuk bergabung dengan forum.</p>

            <form action="/register" method="POST">

                <div class="form-group">
                    <label>Username</label>

                    <input
                        type="text"
                        name="username"
                        placeholder="Masukkan username"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Password</label>

                    <input
                        type="password"
                        name="password"
                        placeholder="Masukkan password"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Konfirmasi Password</label>

                    <input
                        type="password"
                        name="confirmPassword"
                        placeholder="Ulangi password"
                        required
                    >
                </div>

                <button type="submit">
                    Daftar
                </button>

            </form>

            <p>
                Sudah punya akun?
                <a href="/login">Login sekarang</a>
            </p>

        </div>

    </main>

    <footer>
        © 2026 Forum Sahabat Bola
    </footer>

</body>
</html>